<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema utama: Material 3 gelap dengan aksen cyan (nuansa gaming). -->
    <style name="Theme.Zx68" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#00171C</item>
        <item name="colorPrimaryContainer">@color/accent_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_dark_alt</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Label bagian (EFEK, WARNA, KECERAHAN) seperti judul kecil pada software Windows. -->
    <style name="Widget.Zx68.SectionLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tampilan toolbar seragam untuk seluruh layar. -->
    <style name="Widget.Zx68.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg_dark</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="navigationIconTint">@color/accent</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
    </style>

</resources>
